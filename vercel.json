{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/email-sequences",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/marketplace-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/growth-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/growth-weekly",
      "schedule": "0 7 * * 1"
    }
  ]
}
