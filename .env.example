WHOP_PLAN_ID_MONTHLY=
WHOP_PLAN_ID_YEARLY=
WHOP_WEBHOOK_KEY=
NEXT_PUBLIC_WHOP_REDIRECT_URL=
WHOP_API_KEY=
NEXT_PUBLIC_WHOP_PORTAL_LINK=https://whop.com/portal

DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage: use service_role key for uploads (not anon). Create buckets in Dashboard → Storage:
# - product-thumbnails (public) for DALL-E thumbnail caching
# - timeline-media (public) for Video Guide voiceovers and scene media


NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# Pexels: stock photos (Graphics) + B-roll for TikTok Shop. Free key: https://www.pexels.com/api/
# Use server-only PEXELS_API_KEY; do NOT use NEXT_PUBLIC_ for this key.
PEXELS_API_KEY=

# Rate limiting (all API routes): optional. If set, uses Upstash Redis for 20 req/min per user. Else in-memory fallback.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Set to 1 to load Pexels/Unsplash cover images directly (bypass /api/proxy-image). Use if proxy shows broken images.
# NEXT_PUBLIC_USE_DIRECT_IMAGE_URLS=1

# OpenAI (niche generation, post-content captions, TikTok scripts, DALL-E, etc.) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Set to 1 to use minimal Ebook outline prompt and log full raw response (diagnostic for generation failures)
# DIAG_EBOOK_MINIMAL=1

# Anthropic Claude (proof validation) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# HeyGen (UGC Lab + TikTok Shop AI avatar) - https://heygen.com - required for UGC Lab video rendering
HEYGEN_API_KEY=
# Vercel Blob - stores face photos + rendered videos (HeyGen URLs expire in 7 days). https://vercel.com/docs/storage/blob
# BLOB_READ_WRITE_TOKEN=

# ElevenLabs - AI voiceover for Video Timeline import and Video Creation Guide. https://elevenlabs.io/app/settings/api-keys
# Variable name must be exactly: ELEVENLABS_API_KEY (no typo). Copy the key; no quotes in .env.local. Restart dev server after changing.
ELEVENLABS_API_KEY=

# Creatomate (TikTok Shop product-only video renders when HeyGen not used) - https://creatomate.com/docs/api
# API key: Project Settings in Creatomate dashboard. Never expose client-side.
CREATOMATE_API_KEY=
# Template IDs from Creatomate editor (one per video style)
CREATOMATE_TEMPLATE_UNBOXING=
CREATOMATE_TEMPLATE_PROMO=
CREATOMATE_TEMPLATE_DEMO=
CREATOMATE_TEMPLATE_BEFORE_AFTER=
# TikTok Shop Demo pipeline (or use CREATOMATE_TEMPLATE_DEMO)
CREATOMATE_TEMPLATE_TIKTOK_DEMO=
# Digital Products: marketing videos from scripts (hook/body/CTA). Fallback: CREATOMATE_TEMPLATE_PROMO
CREATOMATE_TEMPLATE_DIGITAL_PRODUCT=
# Element names - must EXACTLY match your template layer names
CREATOMATE_ELEMENT_IMAGE=Product-Image
CREATOMATE_ELEMENT_VOICEOVER=Voiceover
CREATOMATE_ELEMENT_SCRIPT=Script-Text

ACTIVE_PAYMENT_PROVIDER=stripe

# Stripe paywall (Content Flywheel Pro)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# App URL for checkout success/cancel and PDF export (preview URL + image resolution). Production: use your real domain (e.g. https://contentflywheel.co.uk)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: secret for PDF preview tokens (headless browser). If unset, CLERK_SECRET_KEY is used.
# PDF_PREVIEW_SECRET=

# Admin bypass: user with this email gets full dashboard access without a subscription
ADMIN_EMAIL=

# Gated features: one password for all "Coming Soon" gates. Set this and you can leave the three below unset.
# Or set per-feature passwords (they take precedence over this).
GATED_FEATURES_PASSWORD=

# Brand Builder: password to unlock. Falls back to GATED_FEATURES_PASSWORD if unset.
BRAND_BUILDER_PASSWORD=

# Campaign Mode: password for private beta access. Falls back to GATED_FEATURES_PASSWORD if unset.
CAMPAIGN_MODE_PASSWORD=

# Feature preview: Video Analytics, Template Studio, Content Calendar. Falls back to GATED_FEATURES_PASSWORD if unset.
FEATURE_PREVIEW_PASSWORD=

# Connected Accounts OAuth (Instagram Basic Display + Facebook)
# Production: set NEXT_PUBLIC_APP_URL=https://contentflywheel.co.uk in Vercel (Project → Settings → Environment Variables)
# Add this exact URL to Meta dashboards (query params like ?platform= are ignored):
#   https://contentflywheel.co.uk/api/connected-accounts/callback
# 1. Facebook Login → Valid OAuth Redirect URIs
# 2. Instagram Basic Display → Valid OAuth Redirect URIs
INSTAGRAM_BASIC_APP_ID=your_instagram_app_id
INSTAGRAM_BASIC_APP_SECRET=your_instagram_app_secret
FACEBOOK_APP_ID=845395761750338
FACEBOOK_APP_SECRET=your_facebook_app_secret

CLERK_COOKIE_DOMAIN=localhost
CLERK_SESSION_TOKEN_LEEWAY=5
CLERK_ROTATE_SESSION_INTERVAL=86400

ACTIVE_PAYMENT_PROVIDER=whop