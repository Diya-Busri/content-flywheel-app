WHOP_PLAN_ID_MONTHLY=
WHOP_PLAN_ID_YEARLY=
WHOP_WEBHOOK_KEY=
NEXT_PUBLIC_WHOP_REDIRECT_URL=
WHOP_API_KEY=
NEXT_PUBLIC_WHOP_PORTAL_LINK=https://whop.com/portal

DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage: create bucket "product-thumbnails" (public read) for DALL-E thumbnail caching


NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# Pexels: stock photos (Graphics) + B-roll for TikTok Shop (e.g. "someone applying" product). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# OpenAI (niche generation, post-content captions, TikTok scripts, DALL-E, etc.) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (proof validation) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# HeyGen (UGC Lab + TikTok Shop AI avatar) - https://heygen.com - required for UGC Lab video rendering
HEYGEN_API_KEY=
# Vercel Blob - stores face photos + rendered videos (HeyGen URLs expire in 7 days). https://vercel.com/docs/storage/blob
# BLOB_READ_WRITE_TOKEN=

# Shotstack Edit API - TikTok-style promo videos (text + product image). Sandbox = free watermarked. https://shotstack.io/docs/api
SHOTSTACK_API_KEY_SANDBOX=
# Optional: production key (uses credits, no watermark)
# SHOTSTACK_API_KEY=

# Creatomate (TikTok Shop product-only video renders when HeyGen not used) - https://creatomate.com/docs/api
# API key: Project Settings in Creatomate dashboard. Never expose client-side.
CREATOMATE_API_KEY=
# Template IDs from Creatomate editor (one per video style)
CREATOMATE_TEMPLATE_UNBOXING=
CREATOMATE_TEMPLATE_PROMO=
CREATOMATE_TEMPLATE_DEMO=
CREATOMATE_TEMPLATE_BEFORE_AFTER=
# TikTok Shop Demo pipeline (or use CREATOMATE_TEMPLATE_DEMO)
CREATOMATE_TEMPLATE_TIKTOK_DEMO=
# Digital Products: marketing videos from scripts (hook/body/CTA). Fallback: CREATOMATE_TEMPLATE_PROMO
CREATOMATE_TEMPLATE_DIGITAL_PRODUCT=
# Element names - must EXACTLY match your template layer names
CREATOMATE_ELEMENT_IMAGE=Product-Image
CREATOMATE_ELEMENT_VOICEOVER=Voiceover
CREATOMATE_ELEMENT_SCRIPT=Script-Text

ACTIVE_PAYMENT_PROVIDER=stripe

# Stripe paywall (Content Flywheel Pro)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# App URL for checkout success/cancel (e.g. https://yourapp.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

CLERK_COOKIE_DOMAIN=localhost
CLERK_SESSION_TOKEN_LEEWAY=5
CLERK_ROTATE_SESSION_INTERVAL=86400

ACTIVE_PAYMENT_PROVIDER=whop